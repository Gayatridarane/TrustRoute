{
  "info": {
    "name": "TrustRoute API",
    "description": "Run Auth > Register (or Login) first; it stores the token automatically. Then run 'Create API (healthy example)' to set {{apiId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Authorization",
        "type": "string"
      },
      {
        "key": "value",
        "value": "Token {{token}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "apiId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"Demo-pass-12345\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"Demo-pass-12345\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Monitored APIs",
      "item": [
        {
          "name": "List APIs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/?page=1&page_size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create API (healthy example)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example Health\",\n  \"url\": \"https://httpbin.org/status/200\",\n  \"method\": \"GET\",\n  \"expected_status\": 200,\n  \"interval_seconds\": 60,\n  \"response_threshold_ms\": 1500,\n  \"timeout_seconds\": 10,\n  \"is_active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('apiId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create API (HTTP 500 example)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Always 500\",\n  \"url\": \"https://httpbin.org/status/500\",\n  \"method\": \"GET\",\n  \"expected_status\": 200,\n  \"interval_seconds\": 60,\n  \"response_threshold_ms\": 1500,\n  \"timeout_seconds\": 10,\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Create API (slow example, 3s delay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Slow 3s\",\n  \"url\": \"https://httpbin.org/delay/3\",\n  \"method\": \"GET\",\n  \"expected_status\": 200,\n  \"interval_seconds\": 60,\n  \"response_threshold_ms\": 1000,\n  \"timeout_seconds\": 10,\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Create API - rejected (localhost / SSRF)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SSRF test\",\n  \"url\": \"http://127.0.0.1:8000/admin/\",\n  \"method\": \"GET\",\n  \"expected_status\": 200,\n  \"interval_seconds\": 60,\n  \"response_threshold_ms\": 1500,\n  \"timeout_seconds\": 10,\n  \"is_active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 for private URL', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create API - rejected (cloud metadata)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metadata test\",\n  \"url\": \"http://169.254.169.254/latest/meta-data/\",\n  \"method\": \"GET\",\n  \"expected_status\": 200,\n  \"interval_seconds\": 60,\n  \"response_threshold_ms\": 1500,\n  \"timeout_seconds\": 10,\n  \"is_active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 for metadata URL', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}"
              ]
            }
          }
        },
        {
          "name": "Update API (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response_threshold_ms\": 800\n}"
            }
          }
        },
        {
          "name": "Disable monitoring",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            }
          }
        },
        {
          "name": "Enable monitoring",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Run manual check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/check/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}",
                "check"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/history/?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}",
                "history"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Analytics (24h)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/analytics/?range=24h",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}",
                "analytics"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "24h"
                }
              ]
            }
          }
        },
        {
          "name": "Analytics (7d)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/analytics/?range=7d",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}",
                "analytics"
              ],
              "query": [
                {
                  "key": "range",
                  "value": "7d"
                }
              ]
            }
          }
        },
        {
          "name": "Delete API",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitored-apis/{{apiId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitored-apis",
                "{{apiId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Incidents & Alerts",
      "item": [
        {
          "name": "List incidents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            }
          }
        },
        {
          "name": "Filter incidents (open, date range)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/?status=open&date_from=2026-01-01&date_to=2026-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                },
                {
                  "key": "date_from",
                  "value": "2026-01-01"
                },
                {
                  "key": "date_to",
                  "value": "2026-12-31"
                }
              ]
            }
          }
        },
        {
          "name": "Search incidents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/?search=timed out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "timed out"
                }
              ]
            }
          }
        },
        {
          "name": "List alerts (unread)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/?is_read=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts"
              ],
              "query": [
                {
                  "key": "is_read",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Mark all alerts read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/mark-all-read/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alerts",
                "mark-all-read"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard & Docs",
      "item": [
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/summary/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard",
                "summary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI schema",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/schema/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "schema"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}