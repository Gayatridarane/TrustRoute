# Copy to .env and edit. Never commit .env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Database: mysql (default) or sqlite (quick local try-out)
DB_ENGINE=mysql
DB_NAME=trustroute
DB_USER=trustroute
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Monitoring
SCHEDULER_ENABLED=True
SCHEDULER_TICK_SECONDS=10
CHECK_WORKERS=4
MIN_CHECK_INTERVAL_SECONDS=30
MAX_APIS_PER_USER=50
CHECK_RETENTION_DAYS=30
CHECK_USER_AGENT=TrustRoute-Monitor/1.0
# DANGER: lets users monitor localhost/private IPs. Keep False except for local demos.
ALLOW_PRIVATE_URLS=False

# Registration / rate limits
ALLOW_REGISTRATION=True
THROTTLE_USER=300/min
THROTTLE_ANON=30/min
THROTTLE_CHECK=20/min
THROTTLE_AUTH=20/min

# Optional email alerts (leave ALERT_EMAIL_ENABLED=False to disable)
ALERT_EMAIL_ENABLED=False
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=alerts@example.com
